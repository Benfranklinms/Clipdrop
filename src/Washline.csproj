<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Washline</AssemblyName>
    <RootNamespace>Washline</RootNamespace>
    <StartupObject>Washline.Program</StartupObject>
    <Version>0.1.0</Version>
    <Product>Washline</Product>
    <Description>Screenshots, hung on a line at the top of your screen.</Description>
  </PropertyGroup>
</Project>
